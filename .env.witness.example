# =============================================================================
# Taranac — HA WITNESS .env (Pro) — copy to `.env` on the witness host:
#     cp .env.witness.example .env      # then edit the values marked EDIT
#
# The witness is a 3rd etcd VOTING member (an arbiter) that runs NO Postgres — just
# etcd — so a 2-node cluster can reach quorum and auto-fail-over safely (docs/guide/ha.md
# §8). It MUST live in a SEPARATE failure domain from the DB nodes (a 3rd host/VM, ideally
# a different rack/site). Co-locating it with a DB node is useless.
#
# Bring it up on the witness host (BEFORE the seed's `ha-convert.sh --continue`):
#     docker compose --env-file .env -f docker-compose.witness.yml up -d
#
# ── This template is SECURE BY DEFAULT ───────────────────────────────────────
# It matches the secure etcd default the DB nodes get from `ha-convert.sh` (#30/#46):
# peer auto-TLS + one-way client TLS. The witness has no tooling, so THIS FILE is where
# the witness's secure default lives — the DB nodes get theirs written into `.env` by
# `ha-convert.sh`, and the `docker-compose.witness.yml` `${VAR:-http}` fallbacks are only
# the inert plaintext value for a hand-rolled `.env` (identical rule to the DB node's
# `docker-compose.ha.yml`). An http witness CANNOT join an https ring, so match the DB
# nodes IDENTICALLY. To opt DOWN to plaintext, see the block at the bottom.
# =============================================================================

# ── Cluster identity (IDENTICAL on every DB node + this witness) ──────────────
# Patroni scope + etcd token — the SAME value the DB nodes use.
TARANAC_CLUSTER_NAME=taranac
# This witness host's address that the DB nodes route to (routable host IP / DNS). EDIT.
NODE_ADDRESS=10.0.0.3
# This member's etcd name (conventionally `witness` — must match its entry below). EDIT.
ETCD_NAME=witness
# EVERY etcd member (both DB nodes + this witness) — the SAME list the DB nodes carry,
# with https:// member URLs for the secure default. EDIT the names/addresses to match.
ETCD_INITIAL_CLUSTER=taranac-node-1=https://10.0.0.1:2380,taranac-node-2=https://10.0.0.2:2380,witness=https://10.0.0.3:2380
ETCD_INITIAL_CLUSTER_STATE=new

# ── Secure etcd — the DEFAULT (peer auto-TLS + one-way client TLS), ha.md §7.3/§8 ──
# Peer channel (2380, cross-host Raft) — auto-TLS: this member self-signs a peer cert at
# boot (zero cert management). The scheme MUST match the https:// member URLs above and be
# consistent across the WHOLE ring.
ETCD_PEER_SCHEME=https
ETCD_PEER_AUTO_TLS=true
# Client channel (2379, Patroni↔etcd + every etcdctl) — one-way TLS with the shared CA.
# BEFORE `up -d`, copy this witness's OOB leaf — `config/cluster-secrets/etcd/witness/`
# from the seed, generated by `ha-convert.sh --prepare` — into `./config/etcd-tls/` on
# THIS host. The paths below point into that dir once it is RO-mounted into the etcd
# container (leave them as-is).
ETCD_CLIENT_SCHEME=https
ETCD_SERVER_CERT_FILE=/etc/etcd/tls/etcd-server.crt
ETCD_SERVER_KEY_FILE=/etc/etcd/tls/etcd-server.key
ETCD_CLIENT_CACERT=/etc/etcd/tls/ca.crt

# ⚠️ FIREWALL 2379/2380 to the cluster's PRIVATE interconnect regardless — TLS is not a
# substitute for the firewall (ha.md §7/§8).

# ── Plaintext opt-out (ONLY if the seed ran `ha-convert.sh --plaintext`) ──────
# A plaintext cluster's witness must ALSO be plaintext — an https witness can't join an
# http ring, and vice-versa. To opt down: set the two peer knobs to http/false, DELETE the
# four client-TLS lines above (no leaf is needed), and use http:// member URLs above:
#   ETCD_PEER_SCHEME=http
#   ETCD_PEER_AUTO_TLS=false
#   ETCD_INITIAL_CLUSTER=taranac-node-1=http://10.0.0.1:2380,taranac-node-2=http://10.0.0.2:2380,witness=http://10.0.0.3:2380
